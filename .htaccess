# ================================
# Configuración de errores y entorno
# ================================
php_flag display_errors On
php_flag display_startup_errors On
php_value error_reporting -1

# Charset por defecto
AddDefaultCharset UTF-8

# Zona horaria
php_value date.timezone "America/Bogota"

# ================================
# Seguridad
# ================================

# Bloquear listado de directorios (403 Forbidden si no hay index.php/html)
Options -Indexes

# Bloquear acceso a archivos ocultos (.htaccess, .gitignore, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Bloquear acceso a archivos sensibles típicos
<FilesMatch "(composer\.json|composer\.lock|package\.json|database\.json|yarn\.lock|phpunit\.xml|\.env)">
    Require all denied
</FilesMatch>

# ================================
# Sistema de rutas
# ================================
RewriteEngine On
# REPLACE_REDIRECT_HTTPS

# Permitir acceso directo a /assets
RewriteCond %{REQUEST_URI} ^/(assets)/ [NC]
RewriteRule ^ - [L]

# Permitir acceso a archivos sin extensión
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)/?$ $1.php [L]

# ================================
# Errores personalizados
# ================================
DirectoryIndex index.php index.html index.htm index2.html

ErrorDocument 400 https://dbproject.rf.gd/error?e=400
ErrorDocument 401 https://dbproject.rf.gd/error?e=401
ErrorDocument 403 https://dbproject.rf.gd/error?e=403
ErrorDocument 404 https://dbproject.rf.gd/error?e=404
ErrorDocument 500 https://dbproject.rf.gd/error?e=500
ErrorDocument 503 https://dbproject.rf.gd/error?e=503